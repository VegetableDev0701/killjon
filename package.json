{
  "name": "nodoia",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme nodoiaStaging",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios --scheme nodoia",
    "ios:open": "xed -b ios",
    "ios:prebuild": "bunx pod-install --repo-update ",
    "android:staging": "bunx react-native run-android --mode=stagingDebug --appId=com.nodoia.nodo.staging",
    "android:staging-release": "bunx react-native run-android --mode=stagingRelease",
    "android:prod": "bunx react-native run-android --mode=prodDebug",
    "android:prod-release": "bunx react-native run-android --mode=prodRelease",
    "android:open": "cd android && open -a \"Android Studio\" . && cd ..",
    "android:prebuild": "cd android && ./gradlew clean && cd ..",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "start": "react-native start",
    "test": "jest"
  },
